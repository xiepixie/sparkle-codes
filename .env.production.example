# ==========================================
# 🌌 Sparkle Codes - Production Example Configuration
# ==========================================

# [SITE] 主站与文档路径配置
# 1Panel 反代时，务必通过 docs.sparkle.codes 路由到本地 3001 端口
NEXT_PUBLIC_WEB_URL="https://sparkle.codes"
NEXT_PUBLIC_DOCS_URL="https://docs.sparkle.codes"

# [DATABASE] Neon Serverless Postgres
# 确保在连接池环境使用 -pooler 后缀
DATABASE_URL="postgresql://user:password@endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# [STORAGE] Cloudflare R2 Credentials
# R2 存储桶用于托管图片及大文件资产
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sparkle-assets"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://cdn.sparkle.codes"
NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.sparkle.codes"

# [REVALIDATE] Cache revalidation credentials
# Sentinel reads REVALIDATE_SECRET and sends it as a query parameter when
# calling the Next.js /api/revalidate endpoint after each sync.
# This value MUST be identical to the REVALIDATE_SECRET configured for Sentinel.
REVALIDATE_SECRET="your_production_secure_secret_here"

# URL(s) Sentinel uses to trigger Next.js cache revalidation.
# Supports comma-separated values for multi-environment purging.
# In a Docker Compose setup the web container listens on localhost:3000.
REVALIDATE_URL="http://127.0.0.1:3000/api/revalidate"

# [RUNTIME] Node.js 运行环境
# Docker 容器内部监听 0.0.0.0 实现跨容器通信
NODE_ENV=production
HOSTNAME="0.0.0.0"
